rue}, 'gcode_shell_command backup_pause': {'command': 'sh /usr/data/helper-script/files/git-backup/git-backup.sh -p', 'timeout': 600.0, 'verbose': True}, 'gcode_shell_command backup_resume': {'command': 'sh /usr/data/helper-script/files/git-backup/git-backup.sh -r', 'timeout': 600.0, 'verbose': True}, 'gcode_macro _git_stop': {'gcode': '\nRUN_SHELL_COMMAND CMD=Backup_Stop\nRESPOND TYPE=command MSG="action:prompt_end"', 'description': 'Stop pushing to GitHub until manually resumed'}, 'gcode_macro _git_pause': {'gcode': '\nRUN_SHELL_COMMAND CMD=Backup_Pause\nRESPOND TYPE=command MSG="action:prompt_end"', 'description': 'Stop pushing to GitHub until next reboot or until manually resumed'}, 'gcode_macro _git_resume': {'gcode': '\nRUN_SHELL_COMMAND CMD=Backup_Resume\nRESPOND TYPE=command MSG="action:prompt_end"', 'description': 'Resume pushing to GitHub'}, 'gcode_macro git_backup_stop': {'gcode': '\nRESPOND TYPE=command MSG="action:prompt_begin Git Backup"\nRESPOND TYPE=command MSG="action:prompt_text Do you want to stop pushing to GitHub until manually resumed?"\nRESPOND TYPE=command MSG="action:prompt_footer_button NO|RESPOND TYPE=command MSG="action:prompt_end"|error"\nRESPOND TYPE=command MSG="action:prompt_footer_button YES|_GIT_STOP|primary"\nRESPOND TYPE=command MSG="action:prompt_show"', 'description': 'Stop pushing to GitHub until manually resumed'}, 'gcode_macro git_backup_pause': {'gcode': '\nRESPOND TYPE=command MSG="action:prompt_begin Git Backup"\nRESPOND TYPE=command MSG="action:prompt_text Do you want to stop pushing to GitHub until next reboot or until manually resumed?"\nRESPOND TYPE=command MSG="action:prompt_footer_button NO|RESPOND TYPE=command MSG="action:prompt_end"|error"\nRESPOND TYPE=command MSG="action:prompt_footer_button YES|_GIT_PAUSE|primary"\nRESPOND TYPE=command MSG="action:prompt_show"', 'description': 'Stop pushing to GitHub until next reboot or until manually resumed'}, 'gcode_macro git_backup_resume': {'gcode': '\nRESPOND TYPE=command